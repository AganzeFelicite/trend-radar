# Copy values into Ansible Vault (infra/ansible/group_vars/all/vault.yml), never into a committed file.

# --- Core ---
DOMAIN=example.com
POSTGRES_DB=trend_radar
POSTGRES_USER=trend_radar
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+psycopg://trend_radar:${POSTGRES_PASSWORD}@postgres:5432/trend_radar

# --- Sources ---
YOUTUBE_API_KEY=                 # restricted to YouTube Data API v3 (+ server IP once known)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=            # app access token only, no user scopes
WIKIMEDIA_USER_AGENT=            # empty = default "TrendRadar/0.1 (<repo URL>)"

# --- Backups (Cloudflare R2) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=                # Object Read & Write, scoped to the backup bucket only
R2_SECRET_ACCESS_KEY=
R2_BACKUP_BUCKET=trend-radar-backups

# --- Email (Resend) ---
RESEND_API_KEY=                  # sending access only, restricted to DOMAIN
EMAIL_FROM="Trend Radar <digest@example.com>"
UNSUBSCRIBE_SECRET=              # random 32+ bytes, signs unsubscribe links

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=@your_public_channel
TELEGRAM_OPS_CHAT_ID=            # your private chat id, for ops alerts

# --- Monitoring ---
SENTRY_DSN_WORKER=
SENTRY_DSN_API=
NEXT_PUBLIC_SENTRY_DSN=
HEALTHCHECKS_PING_URL=

# --- Admin (Caddy basic_auth) ---
ADMIN_USER=admin
ADMIN_PASSWORD_HASH=             # output of: docker run --rm caddy caddy hash-password

# --- Image pulls on the server ---
GHCR_USER=AganzeFelicite
GHCR_READ_TOKEN=                 # classic PAT, read:packages only
